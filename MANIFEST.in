include README.md
include pyproject.toml
include LICENSE

recursive-include backend *.py *.json *.yaml *.yml
recursive-include backend/resources/scripts *
recursive-include backend/resources/frontend/dist *
recursive-include edgestudio_core *.py *.json *.yaml *.yml

prune backend/tests
prune docs
prune tests
prune frontend/node_modules
prune frontend/dist

global-exclude __pycache__ *.py[cod] .DS_Store
